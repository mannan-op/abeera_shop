generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  JAZZCASH
  EASYPAISA
  COD
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum SaleScope {
  ALL
  CATEGORIES
  PRODUCTS
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cartItems CartItem[]

  @@map("users")
}

model Category {
  id          String @id @default(uuid())
  slug        String @unique
  name        String
  description String @default("")
  image       String?
  sortOrder   Int    @default(0)
  /// Show as a circle at the top of /shop.
  showInShop  Boolean @default(true)

  products      Product[]
  saleCampaigns SaleCampaignCategory[]

  @@map("categories")
}

model Product {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  tagline      String    @default("")
  description  String    @default("")
  details      String    @default("")
  materials    String    @default("")
  care         String    @default("")
  categoryId   String
  isNew        Boolean   @default(false)
  isBestSeller Boolean   @default(false)
  rating       Float     @default(0)
  reviewCount  Int       @default(0)
  searchVector Unsupported("tsvector")?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  category      Category               @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  saleCampaigns SaleCampaignProduct[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id             String  @id @default(uuid())
  productId      String
  color          String
  colorHex       String  @default("#888888")
  size           String
  priceInPaisa   Int
  compareAtPrice Int?
  stock          Int     @default(0)
  soldOut        Boolean @default(false)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, color, size])
  @@map("product_variants")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String
  alt       String @default("")
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int
  title     String   @default("")
  body      String   @default("")
  /// New reviews wait for an admin; only PUBLISHED ones show on the shop.
  status    ReviewStatus @default(PENDING)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([status])
  @@map("reviews")
}

model Address {
  id         String @id @default(uuid())
  /// Null for guest checkout addresses.
  userId     String?
  label      String @default("Home")
  name       String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String @default("Pakistan")
  phone      String

  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders Order[]

  @@map("addresses")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@map("cart_items")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  /// Null for guest orders (all new orders). Older orders keep their account link.
  userId      String?
  customerName  String
  customerEmail String
  customerPhone String
  addressId   String
  status      OrderStatus @default(PENDING)
  subtotal       Int
  shipping       Int
  shippingMethod String      @default("standard")
  discount       Int         @default(0)
  tax            Int
  total          Int
  /// The code accepted for this order, when one was used. Usage is counted on the promo row.
  promoCode      String?
  idempotencyKey String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@unique([userId, idempotencyKey])
  @@unique([customerEmail, idempotencyKey])
  @@index([userId])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(uuid())
  orderId      String
  variantId    String
  productName  String
  productSlug  String
  productImage String?
  color        String
  size         String
  price        Int
  quantity     Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  amount        Int
  rawResponse   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

/// Single storefront homepage document. `id` is always "default".
model HomepageContent {
  id        String   @id
  document  Json
  updatedAt DateTime @updatedAt

  @@map("homepage_content")
}

/// An image in the admin media library: a Cloudinary upload or a pasted link.
model MediaAsset {
  id        String   @id @default(uuid())
  url       String
  publicId  String?  @unique
  source    String   @default("link")
  filename  String   @default("")
  alt       String   @default("")
  width     Int?
  height    Int?
  bytes     Int?
  format    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media_assets")
}

/// A timed storefront discount. Live only while active and inside startsAt/endsAt.
model SaleCampaign {
  id           String       @id @default(uuid())
  name         String
  discountType DiscountType
  /// Percent (1–100) or a fixed amount in paisa.
  amount       Int
  startsAt     DateTime
  endsAt       DateTime
  active       Boolean      @default(true)
  scope        SaleScope    @default(ALL)
  bannerText   String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  categories SaleCampaignCategory[]
  products   SaleCampaignProduct[]

  @@index([active, startsAt, endsAt])
  @@map("sale_campaigns")
}

model SaleCampaignCategory {
  campaignId String
  categoryId String

  campaign SaleCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([campaignId, categoryId])
  @@index([categoryId])
  @@map("sale_campaign_categories")
}

model SaleCampaignProduct {
  campaignId String
  productId  String

  campaign SaleCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([productId])
  @@map("sale_campaign_products")
}

/// Admin-managed checkout code. ABEERA10 is inserted by migration.
model PromoCode {
  id           String       @id @default(uuid())
  code         String       @unique
  discountType DiscountType
  /// Percent (1–100) or a fixed amount in paisa, taken off the merchandise subtotal.
  amount       Int
  minSubtotal  Int          @default(0)
  startsAt     DateTime?
  expiresAt    DateTime?
  usageLimit   Int?
  usedCount    Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("promo_codes")
}

/// Single-row JSON documents edited in the admin: "site-settings", "shop-page".
model SiteDocument {
  id        String   @id
  document  Json
  updatedAt DateTime @updatedAt

  @@map("site_documents")
}
