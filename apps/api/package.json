{
  "name": "@abeera/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build --workspace=@abeera/shared",
    "build": "tsc -p tsconfig.json --incremental false",
    "dev": "npm run build --workspace=@abeera/shared && nest start --watch",
    "test": "ts-node --project tsconfig.test.json --transpile-only test/seed-access.test.ts && ts-node --project tsconfig.test.json --transpile-only -r ./test/env.ts test/commerce.test.ts",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "test:seed-access": "ts-node --project tsconfig.test.json --transpile-only test/seed-access.test.ts"
  },
  "dependencies": {
    "@abeera/shared": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.0.0",
    "ioredis": "^5.0.0",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/passport-jwt": "^4.0.0",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5"
  }
}
