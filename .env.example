# Frontend (Next.js / Vercel)
# The catalog is read from the API when NEXT_PUBLIC_API_URL is set.
# That deploy does not fall back to the sample catalog.
# Leave the URL unset on a Next-only preview: the shop renders the
# in-repo sample catalog and shows a banner that the API is missing.
# NEXT_PUBLIC_USE_API=true forces API reads even without a URL (local Nest).
NEXT_PUBLIC_USE_API=false

# Required for any deploy that should read Postgres.
# next build does not call this host; a live request does, and does not
# fall back to the sample catalog when the host is down.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Public routes show a coming soon page unless this is false.
# Set COMING_SOON=false and redeploy to open the shop.
# COMING_SOON=false
